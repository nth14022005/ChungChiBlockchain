@model ViCapFormViewModel
@{
    ViewData["Title"] = "Thêm ví";
}

<h1 class="h3 mb-3">Thêm ví cấp chứng chỉ</h1>
<div class="row"><div class="col-lg-7">
<div class="alert alert-secondary small">
    Chỉ nhập <strong>địa chỉ ví công khai</strong> (0x + 40 ký tự). Tuyệt đối không nhập khóa riêng hay cụm từ khôi phục (seed phrase).
</div>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="ToChucId" class="form-label"></label>
        <select asp-for="ToChucId" asp-items="Model.DanhSachToChuc" class="form-select">
            <option value="">-- Chọn tổ chức --</option>
        </select>
        <span asp-validation-for="ToChucId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DiaChiVi" class="form-label"></label>
        <input asp-for="DiaChiVi" class="form-control font-monospace" placeholder="0x..." autocomplete="off" />
        <span asp-validation-for="DiaChiVi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nhan" class="form-label"></label>
        <input asp-for="Nhan" class="form-control" />
        <span asp-validation-for="Nhan" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
