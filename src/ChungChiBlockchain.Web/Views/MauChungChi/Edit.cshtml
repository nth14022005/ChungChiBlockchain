@model MauChungChiFormViewModel
@{
    ViewData["Title"] = "Sửa mẫu chứng chỉ";
}

<h1 class="h3 mb-3">Sửa mẫu chứng chỉ</h1>
<div class="row"><div class="col-lg-7">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="TenMau" class="form-label"></label>
        <input asp-for="TenMau" class="form-control" autofocus />
        <span asp-validation-for="TenMau" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LoaiChungChiId" class="form-label"></label>
        <select asp-for="LoaiChungChiId" asp-items="Model.DanhSachLoai" class="form-select">
            <option value="">-- Chọn loại --</option>
        </select>
        <span asp-validation-for="LoaiChungChiId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
