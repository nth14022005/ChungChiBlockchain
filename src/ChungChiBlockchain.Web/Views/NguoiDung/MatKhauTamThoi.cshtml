@model MatKhauTamThoiViewModel
@{
    ViewData["Title"] = Model.TieuDe;
}

<div class="row justify-content-center"><div class="col-lg-6">
<div class="card border-warning mt-3">
    <div class="card-header bg-warning-subtle">@Model.TieuDe</div>
    <div class="card-body">
        <p class="mb-1">Người dùng: <strong>@Model.HoTen</strong></p>
        <p class="mb-1">Tên đăng nhập: <code>@Model.TenDangNhap</code></p>
        <p class="mb-3">Mật khẩu tạm thời:</p>
        <div class="p-3 bg-light border rounded text-center">
            <code id="mat-khau-tam" class="fs-4 user-select-all">@Model.MatKhau</code>
        </div>
        <div class="alert alert-danger mt-3 mb-0 small">
            Mật khẩu này <strong>chỉ hiển thị một lần</strong> và hệ thống không lưu bản gốc. Hãy gửi cho người dùng qua kênh
            an toàn và nhắc họ đổi ngay tại mục "Đổi mật khẩu". Đừng tải lại hoặc đóng trang trước khi sao chép.
        </div>
    </div>
</div>
<div class="mt-3"><a class="btn btn-primary" asp-action="Index">Về danh sách người dùng</a></div>
</div></div>
