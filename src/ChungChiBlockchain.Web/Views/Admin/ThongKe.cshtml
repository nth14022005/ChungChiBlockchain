@model BaoCaoHoatDong
@{ ViewData["Title"] = "Thống kê và nhật ký"; }
<h1 class="h3">Thống kê và nhật ký</h1>
<div class="report-grid">
@foreach(var panel in new[] { (Title: "Chứng chỉ theo trạng thái", Rows: Model.TrangThai), (Title: "Lượt xác minh đã lưu", Rows: Model.XacMinh) }) {
    var total = panel.Rows.Sum(x => x.SoLuong);
    <section class="report-panel"><h2>@panel.Title</h2><strong class="total">@total</strong>
    @foreach(var row in panel.Rows) {
        <div class="bar-row"><div><span>@BaoCaoHoatDong.Ten(row.Ma)</span><b>@row.SoLuong</b></div>
        <meter min="0" max="@Math.Max(1,total)" value="@row.SoLuong" aria-label="@BaoCaoHoatDong.Ten(row.Ma)"></meter></div>
    }</section>
}
</div>
<h2 class="h5">50 lần xác minh gần nhất</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Thời gian (UTC)</th><th>Mã chứng chỉ</th><th>Phương thức</th><th>Kết quả</th></tr></thead><tbody>
@foreach(var row in Model.LichSu) { <tr><td>@row.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td><td>@row.ChungChi</td><td>@BaoCaoHoatDong.Ten(row.PhuongThuc)</td><td>@BaoCaoHoatDong.Ten(row.KetQua)</td></tr> }
</tbody></table></div>
<h2 class="h5">50 hoạt động gần nhất</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>ID người dùng</th><th>Hoạt động</th><th>Đối tượng</th></tr></thead><tbody>
@foreach(var row in Model.NhatKy) { <tr><td>@row.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td><td>@row.NguoiDung</td><td>@row.HanhDong</td><td>@row.DoiTuong</td></tr> }
</tbody></table></div>
