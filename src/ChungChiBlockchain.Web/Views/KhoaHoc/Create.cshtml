@model KhoaHocFormViewModel
@{
    ViewData["Title"] = "Thêm khóa học";
}

<h1 class="h3 mb-3">Thêm khóa học</h1>
<div class="row"><div class="col-lg-7">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="mb-3">
        <label asp-for="MaKhoaHoc" class="form-label"></label>
        <input asp-for="MaKhoaHoc" class="form-control text-uppercase" autofocus />
        <div class="form-text">Chữ không dấu, số và _ . - (ví dụ PY101). Không đổi được sau khi tạo.</div>
        <span asp-validation-for="MaKhoaHoc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TenKhoaHoc" class="form-label"></label>
        <input asp-for="TenKhoaHoc" class="form-control" />
        <span asp-validation-for="TenKhoaHoc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ThoiLuong" class="form-label"></label>
        <input asp-for="ThoiLuong" class="form-control" />
        <span asp-validation-for="ThoiLuong" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MoTa" class="form-label"></label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
