@model NguoiDungTaoViewModel
@{
    ViewData["Title"] = "Thêm người dùng";
}

<h1 class="h3 mb-3">Thêm người dùng</h1>
<div class="row"><div class="col-lg-7">
<p class="text-muted small">Hệ thống tự sinh mật khẩu tạm thời và chỉ hiển thị một lần sau khi tạo.</p>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="HoTen" class="form-label"></label>
        <input asp-for="HoTen" class="form-control" autofocus />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TenDangNhap" class="form-label"></label>
        <input asp-for="TenDangNhap" class="form-control" autocomplete="off" />
        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VaiTro" class="form-label"></label>
        <select asp-for="VaiTro" asp-items="Model.DanhSachVaiTro" class="form-select"></select>
        <span asp-validation-for="VaiTro" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ToChucId" class="form-label"></label>
        <select asp-for="ToChucId" asp-items="Model.DanhSachToChuc" class="form-select">
            <option value="">-- Chọn tổ chức --</option>
        </select>
        <div class="form-text">Bắt buộc với "Nhân viên tổ chức cấp". Bỏ qua với "Quản trị hệ thống".</div>
        <span asp-validation-for="ToChucId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
