@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Quản trị";
}

<h1>Tổng quan quản trị</h1>
<p><a class="jump-link" asp-action="ThongKe">Thống kê chứng chỉ, lịch sử xác minh và nhật ký</a></p>

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <a class="text-decoration-none text-reset" asp-controller="NguoiDung" asp-action="Index">
            <div class="card metric h-100"><div class="card-body">
                <div class="display-6">@Model.SoNguoiDung</div><div class="text-muted">Người dùng</div>
            </div></div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="text-decoration-none text-reset" asp-controller="ToChuc" asp-action="Index">
            <div class="card metric h-100"><div class="card-body">
                <div class="display-6">@Model.SoToChuc</div><div class="text-muted">Tổ chức</div>
            </div></div>
        </a>
    </div>
    <div class="col-sm-4">
        <a class="text-decoration-none text-reset" asp-controller="ViCap" asp-action="Index">
            <div class="card metric h-100"><div class="card-body">
                <div class="display-6">@Model.SoViBlockchain</div><div class="text-muted">Ví blockchain</div>
            </div></div>
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Kết nối blockchain</div>
    <div class="card-body">
        <p class="mb-1">Chế độ: <strong>@Model.CheDoBlockchain</strong></p>
        <p class="mb-1">Mạng: <strong>@Model.TenMang</strong></p>
        <p class="mb-3">
            Trạng thái:
            @if (Model.BlockchainSanSang)
            {
                <span class="badge bg-success">Sẵn sàng</span>
            }
            else
            {
                <span class="badge bg-danger">Không kết nối được</span>
            }
        </p>

        <form asp-action="ThuChuoiGiaLap" method="post">
            <button type="submit" class="btn btn-outline-primary">Chạy thử chuỗi giả lập</button>
        </form>

        @if (!string.IsNullOrEmpty(Model.KetQuaThu))
        {
            <pre class="mt-3 p-3 bg-light border rounded" style="white-space: pre-wrap;">@Model.KetQuaThu</pre>
        }
    </div>
</div>
