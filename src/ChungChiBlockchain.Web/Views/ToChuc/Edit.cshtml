@model ToChucFormViewModel
@{
    ViewData["Title"] = "Sửa tổ chức";
}

<h1 class="h3 mb-3">Sửa tổ chức</h1>
<div class="row"><div class="col-lg-7">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TrangThai" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="MaToChuc" class="form-label"></label>
        <input asp-for="MaToChuc" class="form-control" readonly />
        <div class="form-text">Mã tổ chức không đổi được vì đã nằm trong mã chứng chỉ.</div>
    </div>
    <div class="mb-3">
        <label asp-for="TenToChuc" class="form-label"></label>
        <input asp-for="TenToChuc" class="form-control" autofocus />
        <span asp-validation-for="TenToChuc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DiaChi" class="form-label"></label>
        <input asp-for="DiaChi" class="form-control" />
        <span asp-validation-for="DiaChi" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="EmailLienHe" class="form-label"></label>
            <input asp-for="EmailLienHe" class="form-control" />
            <span asp-validation-for="EmailLienHe" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Website" class="form-label"></label>
            <input asp-for="Website" class="form-control" placeholder="https://" />
            <span asp-validation-for="Website" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a class="btn btn-link" asp-action="Index">Hủy</a>
</form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
